{
  "rules": {
    "games": {
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid)",
        ".validate": "data.exists() || newData.child('meta/hostUid').val() === auth.uid",
        "meta": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 30"
          }
        },
        "answers": {
          ".read": "auth != null",
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games/' + $code + '/meta/state').val() === 'question' && root.child('games/' + $code + '/meta/index').val() + '' === $q",
              ".validate": "newData.child('choice').isNumber()"
            }
          }
        },
        "scores": { ".read": "auth != null" },
        "secret": { ".read": "auth != null && root.child('games/' + $code + '/meta/hostUid').val() === auth.uid" }
      }
    },
    "suggestions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || (newData.child('video').isString() && newData.child('video').val().length === 11 && newData.child('text').isString() && newData.child('text').val().length >= 2 && newData.child('text').val().length <= 300 && newData.child('at').isNumber())"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
